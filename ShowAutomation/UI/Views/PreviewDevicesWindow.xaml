<Window x:Class="ShowAutomation.UI.Views.PreviewDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowAutomation.UI.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Preview Devices" Height="300" Width="300"  ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Audio Device: " Grid.Column="1" Grid.Row="1" TextAlignment="Right" VerticalAlignment="Center"/>
        <ComboBox x:Name="audioDeviceComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="180" Height="25" Grid.Column="2" Grid.Row="1" Margin="0,0,-10,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding deviceName}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="MIDI Device: " Grid.Column="1" Grid.Row="6" TextAlignment="Right" VerticalAlignment="Center"/>
        <ComboBox x:Name="midiDeviceComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="180" Height="25" Grid.Column="2" Grid.Row="6" Margin="0,0,-10,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding deviceName}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Video Device: " Grid.Column="1" Grid.Row="3" TextAlignment="Right" VerticalAlignment="Center"/>
        <ComboBox x:Name="videoDeviceComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" Width="180" Height="25" Grid.Column="2" Grid.Row="3" Margin="0,0,-10,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding deviceName}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox x:Name="isDocked" Content="Use Video Panel?"  IsChecked="True" Checked="VideoDocked" Unchecked="VideoDocked" Width="145" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2"/>
        <Grid Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" IsCancel="True" Name="Cancel_Button" Grid.Column="0" Click="Cancel_Click"/>
            <Button Content="Save" IsDefault="True" Name="Save_Button" Grid.Column="3" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
