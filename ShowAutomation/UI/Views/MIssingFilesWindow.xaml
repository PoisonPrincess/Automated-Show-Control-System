<Window x:Class="ShowAutomation.UI.Views.MissingFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Repair Missing File" Height="220" Width="400"
         WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <!-- NAME -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="295"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="labelName" Content="Missing File:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible"/>
            <TextBlock x:Name="txtCommandName" Grid.Column="2" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

                <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="295"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="labelPath" Content="Old Location:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible"/>
            <TextBlock x:Name="txtlabelPath" Grid.Column="2" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
        
        <!-- FILE -->
        <Grid Grid.Row="5" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="labelFile" Content="File" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible"/>
            <TextBox x:Name="txtFilePath" Grid.Column="2" Grid.Row="1" Visibility="Visible"/>
            <Button x:Name="importFileBtn" Content="Import" Grid.Column="4" Grid.Row="1" Visibility="Visible" Click="btnImportFileClick" />
        </Grid>

        <Grid Grid.Row="6" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="300*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtBlockErrorMessageCmd" Text="TextBlock" Foreground="Red" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Hidden" Grid.ColumnSpan="3" Margin="0,0,0,-14" Height="16"/>
        </Grid>
        <!-- PREVIEW ALL/SAVE -->
        <Grid Grid.Row="7" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="CancelButton" Content="Cancel" Grid.Row="1" Click="CancelButton_Click" Grid.ColumnSpan="2"/>

            <Button x:Name="createCommandBtn" Content="Save" Grid.Column="9" Grid.Row="1" Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
