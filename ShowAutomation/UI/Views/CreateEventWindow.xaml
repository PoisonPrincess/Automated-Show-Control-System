<Window x:Class="ShowAutomation.UI.Views.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowAutomation.UI.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Create Event" Height="340" Width="390">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="80" />
            <RowDefinition Height="30"/>
            <RowDefinition Height="60" />
            <RowDefinition Height="50" />


        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="label1" Grid.Column="0" HorizontalContentAlignment="Right" Content="Event Type:" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Height="30" Width="93" FontSize="14" Grid.RowSpan="4"/>

            <ComboBox x:Name="cmbEventType" Grid.Column="1"  HorizontalAlignment="Left" Height="25"  VerticalAlignment="Bottom" Width="130" SelectionChanged="cmbEventType_SelectionChanged" Grid.RowSpan="3">
                <ComboBoxItem>Audio</ComboBoxItem>
                <ComboBoxItem>Video</ComboBoxItem>
                <ComboBoxItem>MIDI</ComboBoxItem>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="55"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label x:Name="lblStartTime" Content="Start Time:" HorizontalContentAlignment="Right"  HorizontalAlignment="Right" VerticalAlignment="Center" Height="27" Width="93" FontSize="14"/>
            <TextBox x:Name="txtHours"  MaxLength="2" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Text="0" VerticalAlignment="Center" Width="22" Grid.Column="1" ToolTip="Hours"/>
            <Label x:Name="lblTimeDivider" Content=":" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Height="27" Width="14" Grid.Column="2"/>
            <TextBox x:Name="txtMinutes" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Text="0" VerticalAlignment="Center" Width="22"  MaxLength="2" Grid.Column="3" ToolTip="Minutes"/>
            <Label x:Name="lblTimeDivider_Copy" Content=":" HorizontalAlignment="Left"  VerticalAlignment="Center" Height="27" Width="14" Grid.Column="4"/>
            <TextBox x:Name="txtSeconds" MaxLength="2" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Text="00" VerticalAlignment="Center" Width="22" Grid.Column="5" ToolTip="Seconds"/>
            <Label x:Name="lblTimeDivider_Copy1" Content=":" HorizontalAlignment="Left"  VerticalAlignment="Center" Height="27" Width="14" Grid.Column="6"/>
            <TextBox x:Name="txtMilliseconds" MaxLength="3" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Text="00" VerticalAlignment="Center" Width="53"  Grid.Column="7" ToolTip="Milliseconds"/>
            <Button x:Name="button" Click="btnEndTime" Content="End Time" HorizontalAlignment="Left" VerticalAlignment="Center" Height="25" Width="55"  Grid.Column="8"/>
        </Grid>

        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Label x:Name="label" Content="Select Command:" HorizontalContentAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center" Height="31" Width="118" FontSize="14" Grid.Column="0"/>
            <ComboBox x:Name="cmbCommands" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="130" Height="25" Grid.Column="1">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock x:Name="textBlock" HorizontalAlignment="Center"  TextWrapping="Wrap" Text="- OR -" VerticalAlignment="Center" Height="20" Width="93" TextAlignment="Center" FontSize="14" Grid.Row="1"/>
            <Button x:Name="btnCreateCommand" Content="Create Command" HorizontalAlignment="Left" Height="25"  VerticalAlignment="Center" Width="130" Click="btnCreateCommandClick" Grid.Column="2" Grid.Row="1"/>

        </Grid>


        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>


            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Label x:Name="label2" Content="Device:" HorizontalContentAlignment="Right" HorizontalAlignment="Right"  VerticalAlignment="Center"  FontSize="14" Grid.Column="0"/>
            <ComboBox x:Name="deviceComboBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="130" Height="25" Grid.Column="1" Margin="0,0,-10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding deviceName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- COLOR
        <Grid Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

          
            <Label x:Name="ColorLabel" Content="Color:" HorizontalAlignment="Right"  VerticalAlignment="Center"  FontSize="14" Width="54" Grid.Column="0"/>
            <ComboBox Name="comboColors" SelectionChanged="ComboColors_SelectionChanged"  HorizontalAlignment="Right" VerticalAlignment="Center"  Height="25" Width="130" Grid.Column="1" >
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid Loaded="ColorsTable_Loaded"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Fill="{Binding Name}" Width="16" Height="16"  />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </Grid>
        -->

        <Grid Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <TextBlock Visibility="Hidden"  Text="{Binding}"  HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" x:Name="txtBlockErrorMessage" Foreground="Red" Height="26" VerticalAlignment="Center" Width="382" Grid.Row="0" />
            <Button x:Name="btnCreateEvent" IsDefault="True" Content="Done" HorizontalAlignment="Center"  Width="198" Click="btnCreateEventClick" Height="34" VerticalAlignment="Bottom" Grid.Row="1"/>
        </Grid>


        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <CheckBox x:Name="isMute" Content="Mute Video Volume?" Width="145"  Visibility="Hidden" Height="20" Grid.Row="0"/>

            <!--<TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Text" Value="Hey, the text should not be empty!"/>
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>-->


        </Grid>
        








    </Grid>


</Window>
