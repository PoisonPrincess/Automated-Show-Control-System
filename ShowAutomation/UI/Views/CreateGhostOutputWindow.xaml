<Window x:Class="ShowAutomation.UI.Views.CreateGhostOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowAutomation.UI.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Add Ghost Output" Height="300" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="labelType" Content="Type" Grid.Column="1"  Grid.Row="1"  HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <ComboBox x:Name="typeCombo" Grid.Column="3" Grid.Row="1">
            <ComboBoxItem>Audio</ComboBoxItem>
            <ComboBoxItem>Video</ComboBoxItem>
            <ComboBoxItem>MIDI</ComboBoxItem>
        </ComboBox>
        <Label x:Name="labelName" Content="Name" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="txtName" Grid.Column="3" Grid.Row="3" HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
        <CheckBox Name="matchOldCheckBox" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="3" Content="Match Missing Device" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Checked="MatchNames" Unchecked="UnmatchNames"/>
        <Button Name="CancelButton" Grid.Column="1" Grid.Row="6" Content="Cancel" IsCancel="True" Click="BtnCancelClick"/>
        <Label Name="labelError" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" Foreground="Red"/>
        <Grid Grid.Column="3" Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Button Name="CreateButton" Grid.Column="1" Grid.Row="5" Content="Create" IsDefault="True" Click="BtnCreateClick"/>
        </Grid>
    </Grid>
</Window>
