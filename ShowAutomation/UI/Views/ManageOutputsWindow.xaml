<Window x:Class="ShowAutomation.UI.Views.ManageOutputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowAutomation.UI.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Manage Outputs" Height="600" Width="500">
    <Window.Resources>
        <Style  TargetType="{x:Type ListViewItem}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="#19f39611"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#19000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OutputInfoItem" DataType="x:Type local:OutputList">
            <Grid Background="{Binding listItemColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding isHidden}" IsEnabled="{Binding Path=HideEnabled}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column= "1" Text="{Binding Path=deviceName}" VerticalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Grid.Column= "2" Text="{Binding Path=displayType}" VerticalAlignment="Center" TextAlignment="Center"/>
                
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Hide" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Name" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Type" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Lanes" TextAlignment="Center" VerticalAlignment="Center"/>

        </Grid>
        <ListView Grid.Column="1" Grid.Row="2"/>
        <ListView x:Name="lvOutputList" AlternationCount="2" Grid.Column="1" Grid.Row="2"
                  ItemTemplate="{StaticResource OutputInfoItem}" HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Column="1" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="DiscardChanges" Content="Cancel" IsCancel="True"/>
            <Button Grid.Column="2" Click="SaveChanges" Content="Save" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
